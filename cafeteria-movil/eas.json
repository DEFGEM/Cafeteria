{
  "cli": {
    "version": ">= 5.9.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cafeteria-api-tqv4.onrender.com",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "15000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cafeteria-api-tqv4.onrender.com",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "15000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://cafeteria-api-tqv4.onrender.com",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "15000"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
